# ─────────────────────────────────────────────────────────────────────────────
# LexiScan – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB connection URI (Docker Compose default shown)
MONGODB_URI=mongodb://localhost:27017

# Google Gemini API key  →  https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini model to use for both contract analysis and RAG chat.
# The default "gemini-4-argon" matches the existing project configuration.
# Change only if you are targeting a different model in your Google AI Studio project.
GEMINI_MODEL=gemini-4-argon

# ─────────────────────────────────────────────────────────────────────────────
# RAG / Vector-Search Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Local filesystem path where Qdrant stores its embedded data.
# WARNING: embedded local mode is for single-process development ONLY.
# Do NOT share this directory across multiple uvicorn worker processes.
# For production use a standalone Qdrant server and configure QDRANT_URL instead.
QDRANT_PATH=./qdrant_data

# Sentence-Transformers model used to generate chunk and query embeddings.
# Changing this requires wiping qdrant_data/ and re-indexing all contracts.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
